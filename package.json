{
  "name": "tapnshow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:e2e": "bun scripts/with-local-supabase.ts playwright test",
    "tokens": "bun scripts/generate-tokens-css.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/server/db/database.types.ts",
    "auth:config": "bun scripts/supabase-auth-config.ts",
    "test:db": "bun scripts/with-local-supabase.ts vitest run --config vitest.db.config.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/core": "11.4.0",
    "@sentry/nextjs": "^11",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "^5.104",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "motion": "^14",
    "next": "16.3.8",
    "next-intl": "^4",
    "next-themes": "^0.4.6",
    "pino": "^10",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.11",
    "react-hook-form": "^7.89",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
