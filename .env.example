# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Server
LOG_LEVEL=info
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# System email (platform Gmail SMTP; local: Mailpit 127.0.0.1:44325, SMTP_REQUIRE_TLS=false)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# Google sign-in (Production + local only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry (DSN is public; the rest are build-time only, set in Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
