# Copy to .env.local. Locally, `bun scripts/with-local-supabase.ts <command>` sets the Supabase
# and SMTP values below from `supabase status` (they win over this file). A test keeps this list
# equal to the variables the app reads (src/config/env-example.test.ts).

# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
# Gates every Google connection (Gmail sending and Google Sheets). Turn it on only where the OAuth
# client has this app's /api/integrations/google/callback redirect URI.
NEXT_PUBLIC_GMAIL_CONNECT_ENABLED=

# Server
LOG_LEVEL=info
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# System email (platform Gmail SMTP; local: Mailpit 127.0.0.1:44325, SMTP_REQUIRE_TLS=false)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# Vercel system variables (set by Vercel when "Automatically expose System Environment Variables" is
# on; leave unset locally). Invite links may use the deployment URLs; anything else falls back to
# NEXT_PUBLIC_APP_URL.
VERCEL_URL=
VERCEL_BRANCH_URL=
VERCEL_ENV=
NEXT_PUBLIC_VERCEL_ENV=

# Google OAuth client: Google sign-in, and the Gmail and Sheets connections (each needs its redirect
# URI registered on the client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sending. Generate each once (README, "First run").
# 32 random bytes, base64 (encrypts Gmail refresh tokens; rotating it breaks every stored connection)
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 32 random bytes, base64url (personal links; rotating it invalidates every link already sent)
INVITE_TOKEN_SECRET=
# 32 random bytes, base64url (Supabase Cron -> /api/internal/dispatch)
DISPATCH_SECRET=

# Google endpoints: only e2e sets these (the fake Google); production uses Google's defaults.
GMAIL_API_BASE_URL=
GOOGLE_OAUTH_AUTHORIZE_URL=
GOOGLE_OAUTH_TOKEN_URL=
GOOGLE_OAUTH_REVOKE_URL=
GOOGLE_SHEETS_API_BASE_URL=
GOOGLE_DRIVE_API_BASE_URL=

# Phone notifications (Web Push, VAPID). All three or none: without them the reminder UI hides and
# the push lane skips. Generate once with `bunx web-push generate-vapid-keys`; rotating the pair ends
# every phone's reminders (spec §15).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services (RFC 8292)
VAPID_SUBJECT=

# Operations: the #platform Discord channel's webhook (production only; unset: events aren't posted)
DISCORD_PLATFORM_WEBHOOK=

# Sentry (the DSN is public; these are build-time only, set in Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
